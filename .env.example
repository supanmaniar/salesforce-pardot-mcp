# ---------------------------------------------------------------------------
# Salesforce Marketing Cloud Account Engagement (Pardot) MCP Server
# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in your values.
# The server reads these from the process environment (it does NOT auto-load
# .env files -- use your MCP client's `env` block, or `node --env-file=.env`).
# ---------------------------------------------------------------------------

# --- Required: OAuth 2.0 client credentials -------------------------------
# From your Salesforce Connected App (enable OAuth, scope: pardot_api).
PARDOT_CLIENT_ID=your_connected_app_consumer_key
PARDOT_CLIENT_SECRET=your_connected_app_consumer_secret

# --- Required: Pardot Business Unit ID ------------------------------------
# Found in Salesforce Setup > Account Engagement > Business Unit Setup.
# Format: 0Uv... (18-char Salesforce ID). Sent as Pardot-Business-Unit-Id.
PARDOT_BUSINESS_UNIT_ID=0UvXXXXXXXXXXXXX

# --- Optional: endpoints --------------------------------------------------
# Login host used for the OAuth token endpoint.
#   Production / dev org : https://login.salesforce.com
#   Sandbox              : https://test.salesforce.com
PARDOT_LOGIN_URL=https://login.salesforce.com

# Pardot API host. Defaults to the production host.
PARDOT_API_DOMAIN=https://pi.pardot.com

# --- Optional: behaviour --------------------------------------------------
# Request timeout in milliseconds (default 60000).
PARDOT_TIMEOUT_MS=60000

# Max retry attempts for 429 / 5xx responses (default 3).
PARDOT_MAX_RETRIES=3

# Set to "true" to allow DELETE and destructive POST /do/ endpoints.
# When false (default), those tools return a refusal instead of executing.
PARDOT_ALLOW_DESTRUCTIVE=false

# Set to "true" to log HTTP requests to stderr (never stdout).
PARDOT_DEBUG=false
