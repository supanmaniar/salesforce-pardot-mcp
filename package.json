{
  "name": "pardot-mcp-server",
  "version": "1.0.0",
  "description": "MCP server exposing the Salesforce Marketing Cloud Account Engagement (Pardot) V5 API, generated from the official Postman collection.",
  "type": "module",
  "bin": {
    "pardot-mcp-server": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "catalog",
    "README.md"
  ],
  "scripts": {
    "generate": "node scripts/generate-catalog.mjs",
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "prepublishOnly": "npm run generate && npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "pardot",
    "salesforce",
    "account-engagement",
    "marketing-cloud"
  ],
  "license": "MIT"
}
